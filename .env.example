APP_NAME=multi-agent-marketing
DATABASE_PATH=storage/app.db
STORAGE_PATH=storage
RETENTION_DAYS=7
CLEANUP_INTERVAL_SECONDS=3600
MAX_FILTER_ROWS=5000
MAX_RETRIES=1

# LLM 接入（真实 Key 只放在本机环境变量，不要提交到 Git）
LLM_PROVIDER=auto
SILICONFLOW_API_KEY=
SILICONFLOW_API_KEY_FALLBACK=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 中等价位、适合中文分析和结构化输出的模型；以硅基流动模型广场实际 ID 为准
SILICONFLOW_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1800

# 可选：切换到 OpenAI 兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
